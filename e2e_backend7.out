│  indent: { firstLine: 480 },\n          children: [\n            new         │
│  TextRun({\n              text: "阳光一小的下课铃永远比上课铃好听。",\n      │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 2\n        new Paragraph({\n          spacing: {  │
│  after: 200 },\n          indent: { firstLine: 480 },\n          children:   │
│  [\n            new TextRun({\n              text:                           │
│  "林小问趴在课桌上，脸贴着冰凉的桌面，眼睛盯着窗外的天空。今天的天空蓝得过   │
│  分，像有人往里面倒了一整瓶蓝墨水。",\n              size: 24,\n             │
│  font: "Arial"\n            })\n          ]\n        }),\n        //         │
│  Paragraph 3 - dialogue line\n        new Paragraph({\n          spacing: {  │
│  after: 200 },\n          children: [\n            new TextRun({\n           │
│  text: "\\u201C林小问！\\u201D",\n              size: 24,\n                  │
│  font: "Arial"\n            })\n          ]\n        }),\n        //         │
│  Paragraph 4\n        new Paragraph({\n          spacing: { after: 200 },\n  │
│  indent: { firstLine: 480 },\n          children: [\n            new         │
│  TextRun({\n              text:                                              │
│  "数学老师张老师的声音从讲台飞过来，像一颗精准的粉笔头\\u2014\\u2014虽然她   │
│  并没有真的扔粉笔头。",\n              size: 24,\n              font:        │
│  "Arial"\n            })\n          ]\n        }),\n        // Paragraph 5   │
│  - dialogue\n        new Paragraph({\n          spacing: { after: 200 },\n   │
│  children: [\n            new TextRun({\n              text:                 │
│  "\\u201C你又在发呆。那我问你，刚才这道题，答案是多少？\\u201D",\n           │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 6\n        new Paragraph({\n          spacing: {  │
│  after: 200 },\n          indent: { firstLine: 480 },\n          children:   │
│  [\n            new TextRun({\n              text:                           │
│  "林小问慢慢坐直，推了推鼻梁上那副圆框眼镜。她根本没听题。",\n               │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 7 - dialogue\n        new Paragraph({\n           │
│  spacing: { after: 200 },\n          children: [\n            new            │
│  TextRun({\n              text:                                              │
│  "\\u201C老师，\\u201D她说，\\u201C我有个问题。\\u201D",\n                   │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 8\n        new Paragraph({\n          spacing: {  │
│  after: 200 },\n          indent: { firstLine: 480 },\n          children:   │
│  [\n            new TextRun({\n              text:                           │
│  "全班哄笑。赵一飞在后排翻了个白眼\\u2014\\u2014又来了。",\n                 │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 9\n        new Paragraph({\n          spacing: {  │
│  after: 200 },\n          children: [\n            new TextRun({\n           │
│  text: "\\u201C你又有什么问题？\\u201D张老师叹了口气。",\n                   │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 10 - dialogue\n        new Paragraph({\n          │
│  spacing: { after: 200 },\n          children: [\n            new            │
│  TextRun({\n              text: "\\u201C为什么天空是蓝色的？\\u201D",\n      │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 11\n        new Paragraph({\n          spacing:   │
│  { after: 200 },\n          indent: { firstLine: 480 },\n                    │
│  children: [\n            new TextRun({\n              text:                 │
│  "笑声更大了。后排的刘子豪拍着桌子喊：\\u201C因为它是蓝的啊！不然还能是红的  │
│  吗哈哈哈哈！\\u201D",\n              size: 24,\n              font:         │
│  "Arial"\n            })\n          ]\n        }),\n        // Paragraph     │
│  12\n        new Paragraph({\n          spacing: { after: 200 },\n           │
│  indent: { firstLine: 480 },\n          children: [\n            new         │
│  TextRun({\n              text:                                              │
│  "张老师敲了敲黑板：\\u201C林小问，现在是数学课。\\u201D",\n                 │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 13\n        new Paragraph({\n          spacing:   │
│  { after: 200 },\n          indent: { firstLine: 480 },\n                    │
│  children: [\n            new TextRun({\n              text:                 │
│  "\\u201C可是我真的想知道，\\u201D林小问不肯坐下，\\u201C光不是白色的吗？太  │
│  阳光是白的，到天上怎么就变蓝了？中间发生了什么？\\u201D",\n                 │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 14\n        new Paragraph({\n          spacing:   │
│  { after: 200 },\n          indent: { firstLine: 480 },\n                    │
│  children: [\n            new TextRun({\n              text:                 │
│  "教室里安静了一秒。",\n              size: 24,\n              font:         │
│  "Arial"\n            })\n          ]\n        }),\n        // Paragraph     │
│  15\n        new Paragraph({\n          spacing: { after: 200 },\n           │
│  indent: { firstLine: 480 },\n          children: [\n            new         │
│  TextRun({\n              text:                                              │
│  "张老师张了张嘴，又闭上了。她是数学老师，不是物理老师。",\n                 │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Paragraph 16\n        new Paragraph({\n          spacing:   │
│  { after: 200 },\n          children: [\n            new TextRun({\n         │
│  text: "\\u201C这个问题\\u2026\\u2026下课后你自己去查。坐下。\\u201D",\n     │
│  size: 24,\n              font: "Arial"\n            })\n          ]\n       │
│  }),\n        // Final paragraph\n        new Paragraph({\n                  │
│  spacing: { after: 200 },\n          indent: { firstLine: 480 },\n           │
│  children: [\n            new TextRun({\n              text:                 │
