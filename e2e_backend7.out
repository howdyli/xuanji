│  35\t_embed_client = OpenAI(\n    36\t    api_key  = DEEPSEEK_API_KEY,\n     │
│  37\t    base_url = os.getenv(\"DEEPSEEK_BASE_URL\") or                      │
│  os.getenv(\"QWEN_BASE_URL\", \"https://api.deepseek.com/v1\"),\n            │
│  38\t)\n    39\t\n    40\t\n    41\t#                                        │
