# XiaoPaw v3.0 Configuration Example
# Copy to config.yaml and fill in your credentials

workspace: "data/workspace"
data_dir: "data"

feishu:
  app_id: "${FEISHU_APP_ID}"        # 飞书应用 App ID
  app_secret: "${FEISHU_APP_SECRET}" # 飞书应用 App Secret
  allowed_chats: []                  # 允许的群聊 ID（空 = 全部允许）

agent:
  model: "deepseek-v4-flash"
  max_iter: 50
  max_input_tokens: 30000
  sub_agent_model: "deepseek-v4-flash"
  sub_agent_max_iter: 20
  timeout_s: 300
  llm_timeout_s: 120

sandbox:
  url: "http://localhost:8030/mcp"
  timeout_s: 120

memory:
  db_dsn: ""  # postgresql://user:pass@localhost:5432/xiaopaw
  hard_limit_lines: 250
  max_save_length: 2000
  compress_threshold: 0.45
  context_window_tokens: 32000
  # 远程长期记忆（agent-memory-system）：需同时开启 feature_flags.enable_remote_memory
  remote_base_url: "${AGENT_MEMORY_URL:-}"     # 如 http://localhost:8000/api/v1（必须含 /api/v1）
  remote_api_key: "${AGENT_MEMORY_API_KEY:-}"  # 记忆系统 API Key（amk_xxx）
  remote_timeout: 10.0
  recall_top_k: 5
  recall_max_chars: 4000
  # Phase 4 片段生命周期治理与摘要化写入
  fragment_ttl_days: 90     # 普通对话片段 TTL（天），0 = 永久保存
  importance_default: 0.4   # 普通片段 importance 分
  importance_high: 0.7      # 含显式陈述（记住/我是/以后…）的片段分
  summary_timeout: 5.0      # LLM 一句话摘要超时（秒），失败回退原文拼接
  # 生命周期管理
  lifecycle_interval_hours: 6
  conflict_check_interval_hours: 24
  # 半衰期配置（天）
  half_life_info: -1          # -1 表示永久
  half_life_plan: 90
  half_life_preference: 1
  half_life_event: 30
  # Phase 5 结构化记忆表白名单（需同时开启 feature_flags.enable_structured_tables）。
  # 不配置时使用内置默认：todo(title/due_date/status)、expense(item/amount/date)。
  # structured_tables:
  #   todo:
  #     - {name: title, type: TEXT}
  #     - {name: due_date, type: TEXT}
  #     - {name: status, type: TEXT}
  #   expense:
  #     - {name: item, type: TEXT}
  #     - {name: amount, type: REAL}
  #     - {name: date, type: TEXT}
  # Phase C1 图谱配置
  graph_depth: 2                  # 图谱查询深度
  graph_ingest_on_save: true      # 保存记忆时同步摄取图谱
  # Phase C2 同步配置
  sync_interval_hours: 12         # 全量同步间隔（小时）
  sync_batch_size: 100            # 同步批次大小

session:
  max_active_sessions: 1000
  max_history_turns: 20

runner:
  max_queue_size: 10
  idle_timeout_s: 300

sender:
  max_retries: 3
  retry_backoff: [1.0, 2.0, 4.0]
  max_concurrent: 5

debug:
  enable_test_api: false  # 仅开发环境启用
  test_api_host: "127.0.0.1"
  test_api_port: 9090
  test_api_token: ""

frontend:
  enabled: true
  host: "127.0.0.1"
  port: 8080

observability:
  metrics_host: "0.0.0.0"
  metrics_port: 8090
  log_json: true
  langfuse_host: "http://localhost:3000"
  langfuse_public_key: ""   # 环境变量: XIAOPAW_LANGFUSE_PUBLIC_KEY（优先）或 LANGFUSE_PUBLIC_KEY
  langfuse_secret_key: ""   # 环境变量: XIAOPAW_LANGFUSE_SECRET_KEY（优先）或 LANGFUSE_SECRET_KEY
  enable_langfuse: true     # 环境变量: TRACE_TO_LANGFUSE=true

rate_limit:
  per_user_per_minute: 20

replay_cache:
  maxsize: 10000
  ttl_sec: 300

cron:
  enabled: true
  check_interval_s: 30
  filelock_timeout_s: 10
  max_dlq_retries: 3

cleanup:
  enabled: true
  session_ttl_days: 180
  trace_ttl_days: 30
  raw_ttl_days: 30
  run_hour_utc: 3

knowledge:
  chunk_strategy: "recursive"    # recursive | structure_aware
  structure_aware:
    topic_similarity_threshold: 0.2
    max_chunk_tokens: 800
    min_chunk_tokens: 100
  # PDF/OCR 配置
  ocr_engine: "vision_model"    # tesseract | vision_model
  ocr_page_limit: 50            # 单次 OCR 最大页数
  ocr_timeout: 30               # OCR 单次请求超时（秒）
  pdf_text_coverage_threshold: 0.3
  enable_knowledge_rerank: true
  rerank_backend: "local"    # local | api | none
  rerank_model: "BAAI/bge-reranker-v2-m3"
  rerank_top_n: 6

skills:
  # User skills directory (relative paths are resolved against project root)
  user_dir: "data/user_skills"
  # Max upload archive size in MB (zip compressed)
  max_upload_mb: 5

feature_flags:
  token_counter_mode: "rough"
  enable_skill_timeout: true
  enable_cron_filelock: true
  enable_memory_save_filelock: true
  enable_trace_id: true
  enable_mcp_whitelist: true
  enable_memory_save_filter: true
  enable_webhook_replay_cache: true
  enable_inbound_rate_limit: true
  enable_multi_agent_collab: false  # P3-1: 开启后走 规划→执行→审查 三角色管线
  enable_remote_memory: false  # 远程长期记忆（agent-memory-system SDK 对接，需配置 memory.remote_*）
  enable_structured_tables: false  # Phase 5: 结构化记忆表工具（需同时开启 enable_remote_memory）
  # ---- 记忆系统升级（P1）— 建议逐步开启 ----
  enable_memory_extraction: false  # LLM 结构化记忆抽取（增加 API 调用，建议先在测试环境验证）
  enable_memory_lifecycle: false   # 记忆生命周期管理（衰减/冷标记，保守开启）
  enable_layered_recall: false     # 三层分层召回（增加 API 调用，建议先确认 agent-memory-system 支持）
  enable_graph_memory: false       # 图谱记忆（实体关系抽取，依赖 agent-memory-system graph 模块）
  enable_memory_sync: false        # 统一双写（本地缓存+远程权威源，建议最后开启）
  enable_deep_pdf_parse: false  # 深度 PDF 解析（pdfplumber 文本+表格提取）
  enable_ocr: false             # 扫描型 PDF OCR 回退（视觉模型）
