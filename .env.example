# XiaoPaw v2 Environment Variables
# Copy to .env and fill in your values

# === Required ===
DEEPSEEK_API_KEY=sk-xxx                    # DeepSeek API Key

# === Feishu (required for production) ===
FEISHU_APP_ID=cli_xxx                  # 飞书应用 App ID
FEISHU_APP_SECRET=xxx                  # 飞书应用 App Secret

# === Environment ===
XIAOPAW_ENV=dev                        # dev | production

# === pgvector (optional, for memory search) ===
# MEMORY_DB_DSN=postgresql://xiaopaw:xiaopaw@localhost:5432/xiaopaw

# === Knowledge-base embedding (optional) ===
# Dedicated client for the qwen3.7-text-embedding model (1024 dims).
# When unset, the knowledge base falls back to the shared DeepSeek/QWEN client.
# KNOWLEDGE_EMBED_API_KEY=sk-xxx
# KNOWLEDGE_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Langfuse (optional, for observability) ===
# TRACE_TO_LANGFUSE=true
# XIAOPAW_LANGFUSE_PUBLIC_KEY=pk-lf-...
# XIAOPAW_LANGFUSE_SECRET_KEY=sk-lf-...
# XIAOPAW_LANGFUSE_BASE_URL=http://localhost:3000

# === TestAPI (dev mode only) ===
# XIAOPAW_TESTAPI_TOKEN=your-dev-token
